);


// =====================================
// 🔄 Update Customers
// =====================================

function updateCustomersFromOrders() {

    customersData =
        buildCustomers(
            dashboard.orders || []
        );

    renderCustomers(
        customersData
    );

}


// =====================================
// 🔗 Dashboard Update ላይ Customers
// =====================================

const originalDashboardUpdate =
    dashboard.update.bind(dashboard);


dashboard.update =
    function() {

        originalDashboardUpdate();

        updateCustomersFromOrders();

    };


